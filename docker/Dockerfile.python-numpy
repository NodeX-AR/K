# Comparison image: Python + numpy, for sizing K's containers against
# the ecosystem it's positioned as an alternative to for numeric/
# scripting work. NOT MEASURED here — see docker/Dockerfile.k for why.
#
# Build: docker build -f docker/Dockerfile.python-numpy -t py-numpy .
# Compare: docker images | grep -E 'k-lang|py-numpy'

FROM python:3.12-slim
RUN pip install --no-cache-dir numpy
ENTRYPOINT ["python3"]
